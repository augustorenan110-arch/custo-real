{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "title": "A\u00e7\u00e3o"
    },
    "result": {
      "type": "string",
      "enum": [
        "sucesso",
        "recusado"
      ],
      "title": "Resultado"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string",
      "title": "Quem executou"
    },
    "confidence": {
      "type": "number"
    },
    "details": {
      "type": "string",
      "title": "Detalhes"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "selfie_uri": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "result"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}