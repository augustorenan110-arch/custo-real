{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa (id) \u2014 isola a auditoria por empresa"
    },
    "action": {
      "type": "string",
      "title": "A\u00e7\u00e3o"
    },
    "result": {
      "type": "string",
      "enum": [
        "sucesso",
        "recusado"
      ],
      "title": "Resultado"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "actor_email": {
      "type": "string",
      "title": "Quem executou"
    },
    "confidence": {
      "type": "number"
    },
    "details": {
      "type": "string",
      "title": "Detalhes"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "endereco": {
      "type": "string",
      "title": "Endere\u00e7o completo (geocodifica\u00e7\u00e3o reversa)"
    },
    "rua": {
      "type": "string",
      "title": "Rua / n\u00famero"
    },
    "bairro": {
      "type": "string",
      "title": "Bairro"
    },
    "cidade_uf": {
      "type": "string",
      "title": "Cidade - UF"
    },
    "selfie_uri": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "result"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.company_id": "{{user.data.company_id}}"
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "data.is_super_admin": true
      }
    },
    "delete": {
      "user_condition": {
        "data.is_super_admin": true
      }
    }
  }
}