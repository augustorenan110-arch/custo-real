{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "title": "Empresa (id)"
    },
    "company_name": {
      "type": "string",
      "title": "Nome da empresa"
    },
    "cnpj": {
      "type": "string",
      "title": "CNPJ"
    },
    "plan": {
      "type": "string",
      "title": "Plano",
      "enum": [
        "STARTER",
        "PREMIUM"
      ],
      "default": "PREMIUM"
    },
    "amount": {
      "type": "number",
      "title": "Valor mensal (R$)",
      "default": 59.9
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "trial",
        "active",
        "canceled"
      ],
      "default": "trial"
    },
    "trial_ends_at": {
      "type": "string",
      "title": "Fim do teste (ISO)"
    },
    "commission_to_accountant": {
      "type": "number",
      "title": "Comiss\u00e3o do contador (R$)",
      "default": 17.97
    },
    "accountant_id": {
      "type": "string",
      "title": "Contador (id)"
    },
    "accountant_name": {
      "type": "string",
      "title": "Contador"
    },
    "owner_whatsapp": {
      "type": "string",
      "title": "WhatsApp do dono"
    },
    "activated_at": {
      "type": "string",
      "title": "Ativada em (ISO)"
    },
    "metodo_pagamento": {
      "type": "string",
      "title": "M\u00e9todo de pagamento",
      "enum": [
        "pix",
        "cartao"
      ]
    },
    "whatsapp_message": {
      "type": "string",
      "title": "Mensagem enviada (simulada)"
    }
  },
  "required": [
    "company_id",
    "cnpj",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}