{
  "name": "Expense",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "title": "Valor (R$)"
    },
    "expense_date": {
      "type": "string",
      "format": "date",
      "title": "Data da despesa"
    },
    "merchant": {
      "type": "string",
      "title": "Estabelecimento"
    },
    "category": {
      "type": "string",
      "title": "Categoria",
      "enum": [
        "Refei\u00e7\u00e3o",
        "Transporte",
        "Hospedagem",
        "Material",
        "Combust\u00edvel",
        "Outros"
      ],
      "default": "Outros"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o / justificativa"
    },
    "receipt_file_uri": {
      "type": "string",
      "title": "Recibo (arquivo privado)"
    },
    "status": {
      "type": "string",
      "title": "Situa\u00e7\u00e3o",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "ai_compliant": {
      "type": "boolean",
      "title": "Dentro da pol\u00edtica (IA)"
    },
    "ai_notes": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o da IA"
    },
    "review_note": {
      "type": "string",
      "title": "Coment\u00e1rio do RH"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Revisado por"
    },
    "reviewed_at": {
      "type": "string",
      "title": "Revisado em"
    },
    "employee_name": {
      "type": "string",
      "title": "Colaborador"
    },
    "employee_email": {
      "type": "string",
      "title": "E-mail do colaborador"
    }
  },
  "required": [
    "amount",
    "expense_date",
    "category",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    }
  }
}