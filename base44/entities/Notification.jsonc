{
  "name": "Notification",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "title": "T\u00edtulo"
    },
    "mensagem": {
      "type": "string",
      "title": "Mensagem"
    },
    "lida": {
      "type": "boolean",
      "title": "Lida",
      "default": false
    },
    "criada_em": {
      "type": "string",
      "title": "Criada em (ISO)"
    }
  },
  "required": [
    "titulo",
    "mensagem"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}