{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "consentimento_biometria": {
      "type": "boolean",
      "title": "Consentimento de biometria",
      "default": false
    },
    "data_consentimento": {
      "type": "string",
      "title": "Data do consentimento (ISO)"
    },
    "ip_consentimento": {
      "type": "string",
      "title": "IP do consentimento"
    },
    "is_accountant": {
      "type": "boolean",
      "title": "\u00c9 contador",
      "default": false
    },
    "referral_code": {
      "type": "string",
      "title": "C\u00f3digo de indica\u00e7\u00e3o (ex: CONTADOR123)"
    },
    "office_name": {
      "type": "string",
      "title": "Escrit\u00f3rio cont\u00e1bil"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "cnpj_escritorio": {
      "type": "string",
      "title": "CNPJ do escrit\u00f3rio"
    },
    "commission_balance": {
      "type": "number",
      "title": "Saldo de comiss\u00e3o (R$)",
      "default": 0
    }
  },
  "required": [
    "role"
  ]
}