{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "tipo_conta": {
      "type": "string",
      "title": "Tipo de conta",
      "enum": [
        "super_admin",
        "empresa",
        "escritorio"
      ],
      "default": "empresa"
    },
    "plano": {
      "type": "string",
      "title": "Plano do usu\u00e1rio",
      "enum": [
        "gratis_7dias",
        "pago_59",
        "escritorio_parceiro"
      ],
      "default": "gratis_7dias"
    },
    "data_cadastro": {
      "type": "string",
      "format": "date",
      "title": "Data do cadastro"
    },
    "limite_funcionarios": {
      "type": "number",
      "title": "Limite de funcion\u00e1rios (3 no gr\u00e1tis)",
      "default": 3
    },
    "consentimento_biometria": {
      "type": "boolean",
      "title": "Consentimento de biometria",
      "default": false
    },
    "data_consentimento": {
      "type": "string",
      "title": "Data do consentimento (ISO)"
    },
    "ip_consentimento": {
      "type": "string",
      "title": "IP do consentimento"
    },
    "is_accountant": {
      "type": "boolean",
      "title": "\u00c9 contador",
      "default": false
    },
    "referral_code": {
      "type": "string",
      "title": "C\u00f3digo de indica\u00e7\u00e3o (ex: CONTADOR123)"
    },
    "office_name": {
      "type": "string",
      "title": "Escrit\u00f3rio cont\u00e1bil"
    },
    "whatsapp": {
      "type": "string",
      "title": "WhatsApp"
    },
    "cnpj_escritorio": {
      "type": "string",
      "title": "CNPJ do escrit\u00f3rio"
    },
    "commission_balance": {
      "type": "number",
      "title": "Saldo de comiss\u00e3o (R$)",
      "default": 0
    }
  },
  "required": [
    "role"
  ]
}