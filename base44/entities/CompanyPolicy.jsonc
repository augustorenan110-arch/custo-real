{
  "name": "CompanyPolicy",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "title": "Pol\u00edtica de despesas"
    },
    "updated_by": {
      "type": "string",
      "title": "Atualizado por",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "data.is_super_admin": true
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.is_super_admin": true
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "data.is_super_admin": true
      }
    }
  }
}