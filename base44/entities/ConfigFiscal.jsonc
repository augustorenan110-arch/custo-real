      "type": "number",
      "title": "Faixa de (R$)"
    },
    "faixa_ate": {
      "type": "number",
      "title": "Faixa at\u00e9 (R$)"
    },
    "valor_fixo": {
      "type": "number",
      "title": "Valor fixo / dedu\u00e7\u00e3o (R$)"
    },
    "data_vigencia": {
      "type": "string",
      "format": "date",
      "title": "Vig\u00eancia"
    },
    "fonte_oficial": {
      "type": "string",
      "title": "Fonte oficial"
    },
    "atualizado_em": {
      "type": "string",
      "title": "Atualizado em (ISO)"
    }
  },
  "required": [
